# Copy to .env.local and fill in real values. Never commit .env* files.

# --- Admin auth ---
ADMIN_PASSWORD=
ADMIN_SESSION_SECRET=
ADMIN_API_KEY=

# --- Google Sheets / Drive ---
# GOOGLE_SHEET_TAB defaults to "契約社リスト" (the real contract-list tab) if unset.
GOOGLE_SHEET_ID=
GOOGLE_SHEET_TAB=
# Defaults to "承認待ち" if unset. Feeds the /admin dashboard's pending-count
# and recent-generations table (Module C).
GOOGLE_SHEET_APPROVAL_TAB=
GOOGLE_SERVICE_ACCOUNT_KEY=
DRIVE_ROOT_FOLDER_ID=

# --- Admin: BGM/SE media library (/admin/media) ---
# Google Drive folder IDs. The service account must be shared as Editor on each.
BGM_FOLDER_ID=
SE_FOLDER_ID=

# --- Admin: dashboard cost estimate (/admin, hidden if either is unset) ---
COST_PER_VIDEO_STD=
COST_PER_VIDEO_PREMIUM=

# --- n8n: billing ---
N8N_BILLING_KEY=
N8N_RECON_KEY=

# --- Backend relay: customer telop-revision flow (app/revise/[approvalId]) ---
REVISE_RELAY_KEY=
REVISE_INFO_URL=
REVISE_SUBMIT_URL=

# Copy to .env.local and fill in real values. Never commit .env* files.

# --- Admin auth ---
ADMIN_PASSWORD=
ADMIN_SESSION_SECRET=
ADMIN_API_KEY=

# --- Google Sheets / Drive ---
# GOOGLE_SHEET_TAB defaults to "契約社リスト" (the real contract-list tab) if unset.
GOOGLE_SHEET_ID=
GOOGLE_SHEET_TAB=
# Defaults to "承認待ち" if unset. Feeds the /admin dashboard's pending-count
# and recent-generations table (Module C).
GOOGLE_SHEET_APPROVAL_TAB=
GOOGLE_SERVICE_ACCOUNT_KEY=
DRIVE_ROOT_FOLDER_ID=

# --- Admin: BGM/SE media library (/admin/media) ---
# Google Drive folder IDs. The service account must be shared as Editor on each.
BGM_FOLDER_ID=
SE_FOLDER_ID=

# --- Admin: dashboard cost estimate (/admin, hidden if either is unset) ---
COST_PER_VIDEO_STD=
COST_PER_VIDEO_PREMIUM=

# --- Admin: sales/prospect list viewer (/admin/sales, read-only) ---
# Separate spreadsheet from GOOGLE_SHEET_ID. Every tab is shown; the service
# account only needs Viewer access on this one.
SALES_SHEET_ID=

# --- Admin: LINE Bot knowledge editor (/admin/line) ---
# Tab name inside each client's own line_data_sheet_id spreadsheet (a
# different spreadsheet per client, looked up via 契約社リスト — not this
# spreadsheet). Defaults to "LINEナレッジ" if unset.
LINE_KNOWLEDGE_TAB=

# --- Admin: AI model registry (/admin/models) ---
# Tab names inside GOOGLE_SHEET_ID, auto-created on first use if missing.
# Defaults to "モデル登録" / "プラン設定" if unset.
GOOGLE_SHEET_MODELS_TAB=
GOOGLE_SHEET_PLANS_TAB=
# OpenRouter key for the "docs URLから自動入力" assist button. Fail-soft: the
# button is disabled client-side (with a "環境変数が必要" note) if this is unset.
OPENROUTER_API_KEY=

# --- Admin: banned-word list (/admin/banned-words) ---
# Tab name inside GOOGLE_SHEET_ID, auto-created (seeded with the current
# n8n-hardcoded 11-word list) on first use if missing. Defaults to "禁止語"
# if unset.
GOOGLE_SHEET_BANNED_WORDS_TAB=

# --- n8n: billing ---
N8N_BILLING_KEY=
N8N_RECON_KEY=

# --- Backend relay: customer telop-revision flow (app/revise/[approvalId]) ---
REVISE_RELAY_KEY=
REVISE_INFO_URL=
REVISE_SUBMIT_URL=

# --- Admin: manual pages (/admin/manual) ---
# No new env vars — copy boxes on the LINE setup manual are derived from the
# two above: GOOGLE_SERVICE_ACCOUNT_KEY (-> client_email) and REVISE_INFO_URL
# (-> origin + /webhook/line-ai). See app/_lib/manualValues.ts.
#
# NOTE: link_hp_url / link_line_url / drive_folder_id (admin operability v1,
# 2026-07-11) are new 契約社リスト columns that must be added to the actual
# sheet's header row — no env var covers this, it's a one-time manual sheet edit.

# --- Client portal (/portal) ---
# Fully separate secret from ADMIN_SESSION_SECRET (see app/_lib/portalAuth.ts)
# — internal admin sessions and external client sessions must not share a
# key. Fail-closed: unset means nobody can log in (never falls back to a
# guessable default).
PORTAL_SESSION_SECRET=
# NOTE: portal_password / portal_enabled (顧客ポータルP1, 2026-07-12,
# docs/property_db_f_design.md §P1.1) are 2 more new 契約社リスト columns —
# same one-time manual sheet-header-row edit as the NOTE above, no env var.

# --- 物件DB / /f ポートフォリオページ ---
# Tab name inside EACH CLIENT'S OWN line_data_sheet_id spreadsheet (same
# per-client-spreadsheet pattern as LINE_KNOWLEDGE_TAB, NOT this app's
# GOOGLE_SHEET_ID). Defaults to "物件" if unset. See app/_lib/properties.ts
# and docs/property_db_f_design.md §1-§2.
PROPERTY_TAB=
# NOTE: license_number / transaction_type_default / portfolio_slug /
# portfolio_enabled / line_staff_user_ids (物件DB+/f, 2026-07-12,
# docs/property_db_f_design.md §1.3) are 5 more new 契約社リスト columns —
# same one-time manual sheet-header-row edit as the portal_* NOTE above, no
# env var. Until added, a client's /f/[slug] page 404s (portfolio_slug/
# portfolio_enabled read as "").

# --- Client portal (/portal/submit): 動画生成依頼フォーム ---
# 送信ゲート(構造的安全装置): 文字列 "true" のときだけ n8n webhook へ
# 実POSTする。未設定/false はドライラン = Drive への実アップロードと
# ペイロード組み立て・検証までは行い、webhook POST の直前で停止して
# 「送信機能は準備中です」を返す(仕様書(5)-①送信ゲート方式)。
# 本番POSTの解禁は岡本のGOが出てから(課金テスト規律)。
PORTAL_SUBMIT_ENABLED=
# 本番 webhook URL(fudosan-video-prod・バージョンレス恒久URL)。
# コードにはハードコードしない(publicリポ)。未設定のままフラグを
# true にすると送信時に設定エラーで止まる(fail-closed)。
PORTAL_SUBMIT_WEBHOOK_URL=
# exec_<uuid12>/{original,maisoku} フォルダの親。GAS標準フォーム
# (fudosan-video/docs/forms_v15/standard_form.gs)の
# CLIENT_ROOT_FOLDER_ID と同一のIDを設定すること — 夜間掃除cron
# (素材7日保持)の回収対象がここだから、別の場所にしてはいけない
# (仕様書(3))。SA(GOOGLE_SERVICE_ACCOUNT_KEY)に編集者共有が必須。
PORTAL_SUBMIT_ROOT_FOLDER_ID=

# --- Client portal (/portal): production-status feed ---
# Tab name inside the SAME central spreadsheet as 承認待ち (GOOGLE_SHEET_ID).
# Written by fudosan_v15-prod's `PortalStatus: Insert Received` node (n8n
# side, out of scope here) — this app only reads it (fail-soft: a
# not-yet-created tab or missing columns just yield an empty list, not a
# 500). Defaults to "制作状況" if unset.
GOOGLE_SHEET_PRODUCTION_TAB=
